import pandas as pd

df = pd.read_csv("data/12_metro_digital.csv")

print("데이터 크기(행, 열):", df.shape)
print("-" * 50)

print("\n[앞부분 데이터 10줄 미리보기]")
print(df.head(10)) 

print("\n[뒷부분 데이터 7줄 미리보기]")
print(df.tail(7))  

