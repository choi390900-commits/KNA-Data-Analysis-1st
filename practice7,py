import pandas as pd

df = pd.read_csv("data/12_metro_compressor.csv")

print("=== 1. head(1) 출력 (맨 위 1줄) ===")
print(df.head(1))
print("\n")

print("=== 2. head(10) 출력 (맨 위 10줄) ===")
print(df.head(10))
print("\n")

print("=== 3. tail(7) 출력 (맨 아래 7줄) ===")
print(df.tail(7))
print("\n")

print("=== 4. head(500) 출력 (데이터보다 큰 숫자 입력) ===")
print(df.head(500))

